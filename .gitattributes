# 统一换行符：源码用 LF，Windows 批处理用 CRLF，避免跨平台 clone 后 gradlew 跑不起来
* text=auto

*.kt      text eol=lf
*.kts     text eol=lf
*.xml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.pro     text eol=lf
*.keep    text eol=lf
gradlew   text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf

*.jar     binary
*.png     binary
*.webp    binary
*.jpeg    binary
*.jpg     binary
